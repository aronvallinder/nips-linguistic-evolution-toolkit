# Copy to .env and fill in the keys you need. src/utils.py loads this file
# at import time via python-dotenv.

# Main provider (OpenRouter routes to most models used in the experiments)
OPENROUTER_API_KEY=

# Optional direct-provider keys (used when LLM_PROVIDER selects them,
# or by provider-specific runs)
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional overrides (see src/utils.py)
# LLM_PROVIDER=auto
# OPENROUTER_MAX_TOKENS=
# OPENROUTER_REASONING_EFFORT=
# Direct-Anthropic responses default to max_tokens=1024, which truncates
# verbose game analyses before the JSON decision. Raise it:
ANTHROPIC_MAX_TOKENS=4096

# Optional historical-run backup; see docs/hugging_face_dataset_sync.md.
# Requires the usual HF_DATASET_AUTO_UPLOAD, REPO and NAMESPACE settings.
# HF_DATASET_ALLOW_LEGACY_PROVENANCE=1
