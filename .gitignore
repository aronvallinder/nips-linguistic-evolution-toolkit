# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
ENV/

# --- Secrets / local env ---
.env
.env.*
!.env.example
credentials.json
token.pickle
token.json
**/service-account*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Jupyter ---
.ipynb_checkpoints/

# --- Local IDE / agent state (machine-specific) ---
.cursor/
.claude/

# Override: this fork tracks .claude/ because it ships the manuscript-workflow
# agents/skills/hooks (ms-writer, ms-render, ms-pdf-extract, ms-guard.sh, etc.)
# used by projects/neurips-2026-llm-ling-evo. Local IDE state stays excluded.
!.claude/

# --- Ephemeral noise-run configs ---
noise/tmp*.yaml

# --- Omit from remote until ready (large / in-progress batch) ---
data/json/noise_experiments/v2/noise_negative_mem3_gpt5_nano/

# --- Common large ML/binary artifacts (if ever added) ---
*.pt
*.bin
*.safetensors
*.ckpt
*.npz
wandb/

# --- Downloaded reference PDFs ---
# Re-downloadable from arxiv / PMC / publishers; markdown extractions in
# references/md/ are tracked (canonical agent-readable content).
projects/*/references/pdfs/*.pdf

# --- Scratch ---
*.tmp
.cache/

# Local (untracked) skill config overrides
.claude/skills/*/config.local.yml

# --- Large regenerable experiment outputs (kept out of git) ---
# Raw run JSON, plot PNGs, and curated share bundles are reproducible from
# configs + runners; back these up outside git (external drive / bucket / LFS).
data/json/
data/plots/
data/share/

# Local mirror created by the Hugging Face dataset download command
nlet-hf-data/

# Local agent harness state
.claude/scheduled_tasks.lock

# Local clone used by scripts/refresh_inspector_site.sh
.inspector-site/
.inspector-refresh.log
data/shared_runs/
data/.hf_stage/
.data-sync.log

# Local analysis outputs (large; regenerate via scripts/analyze_*.py)
data/analysis/
